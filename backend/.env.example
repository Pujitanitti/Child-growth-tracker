# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5500

# Database
MONGO_URI=mongodb://127.0.0.1:27017/child-growth-tracker

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_RESET_SECRET=replace_with_another_long_random_string
JWT_RESET_EXPIRES_IN=15m

# Uploads
MAX_UPLOAD_MB=5

# Email (used for password reset + reminder emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="Child Growth Tracker <no-reply@growthtracker.app>"

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=200

# AI Health Assistant (optional — leave blank to disable the feature entirely)
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
